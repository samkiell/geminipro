# Copy to .env for local development. Never commit .env.
# Blank values count as unset, so defaults apply.

# --- server ---
NODE_ENV=development
PORT=3000
# Public https URL of the service (Render gives https://<service>.onrender.com)
PUBLIC_URL=http://localhost:3000

# --- telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Public link: https://t.me/geminiprosamkiel_bot
TELEGRAM_BOT_USERNAME=geminiprosamkiel_bot
# 16 to 256 chars of A-Z a-z 0-9 _ -  (e.g. openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# Comma separated Telegram user ids allowed to run admin commands
ADMIN_TELEGRAM_IDS=

# --- bachs (payments) ---
# sk_sandbox_... while testing (sandbox-api.bachs.io), sk_live_... at launch (api.bachs.io)
BACHS_SECRET_KEY=
# Signing secret of the webhook endpoint for https://<PUBLIC_URL>/bachs/webhook
# (developer portal > Webhooks, or printed by `bachs listen` when testing locally)
BACHS_WEBHOOK_SECRET=
# false: Bachs fee_preference is customer_pays, so Bachs adds the exact fee at checkout (recommended).
# true: fee_preference is org_pays, so the bot adds FEE_PCT/FEE_FLAT to the total itself.
GROSS_UP=false
# NGN card 2%, NGN bank transfer 1.5% (capped at 2000). Only used when GROSS_UP=true.
FEE_PCT=0.02
FEE_FLAT=0

# --- reseller ---
RESELLER_BASE_URL=https://api-geminipro.ignorelist.com/api/reseller/v1
# Any non-empty value works when RESELLER_MOCK=true
RESELLER_API_KEY=
# Numeric id from GET /products. "Gemini Pro 18 Months" is 1.
RESELLER_PRODUCT_ID=1
# true: buy from the mock reseller (npm run mock:reseller) instead of the real API.
# Must be true with sk_sandbox_ keys and false with sk_live_ keys; the app refuses to boot otherwise.
RESELLER_MOCK=true
RESELLER_MOCK_URL=http://127.0.0.1:4010/api/reseller/v1

# --- groq ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Comma separated, tried in order when GROQ_MODEL errors or rate limits
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- database ---
# Neon pooled connection string, with sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- business ---
UNIT_PRICE_NGN=3500
MAX_QTY_PER_ORDER=10
# Alert when the reseller balance covers fewer than this many links
LOW_BALANCE_ORDERS=5
SUPPORT_WHATSAPP=08087357158
# Last day to claim the offer; the bot tells buyers to activate before it
OFFER_DEADLINE=2026-10-29

# --- alerts ---
ALERT_EMAIL=hello@samkiel.dev
# Optional. Without it, email alerts are only logged.
RESEND_API_KEY=
NTFY_TOPIC=

# --- optional ---
# Stop selling after this time. ISO with offset, e.g. 2026-10-29T19:30:00+01:00. Empty = no cutoff.
SALES_CUTOFF=

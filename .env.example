# Copy to .env for local development. Never commit .env.
# Blank values count as unset, so defaults apply.

# --- server ---
NODE_ENV=development
PORT=3000
# Public https URL of the service (Render gives https://<service>.onrender.com)
PUBLIC_URL=http://localhost:3000

# --- telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Public link: https://t.me/geminiprosamkiel_bot
TELEGRAM_BOT_USERNAME=geminiprosamkiel_bot
# 16 to 256 chars of A-Z a-z 0-9 _ -  (e.g. openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# Comma separated Telegram user ids allowed to run admin commands
ADMIN_TELEGRAM_IDS=

# --- bachs (payments) ---
# sk_sandbox_... while testing (sandbox-api.bachs.io), sk_live_... at launch (api.bachs.io)
BACHS_SECRET_KEY=
# Signing secret of the webhook endpoint for https://<PUBLIC_URL>/bachs/webhook
# (developer portal > Webhooks, or printed by `bachs listen` when testing locally)
BACHS_WEBHOOK_SECRET=
# Optional. Empty: picked from the key (sandbox-api.bachs.io or api.bachs.io)
BACHS_BASE_URL=
# false: Bachs fee_preference is customer_pays, so Bachs adds the exact fee at checkout (recommended).
# true: fee_preference is org_pays, so the bot adds FEE_PCT/FEE_FLAT to the total itself.
GROSS_UP=false
# Payment fee calculation settings. Only used when GROSS_UP=true.
FEE_PCT=0.02
FEE_FLAT=0

# --- reseller ---
RESELLER_BASE_URL=https://api-geminipro.ignorelist.com/api/reseller/v1
# Any non-empty value works when RESELLER_MOCK=true
RESELLER_API_KEY=
# Numeric id from GET /products. "Gemini Pro 18 Months" is 1.
RESELLER_PRODUCT_ID=1
# true: buy from the mock reseller (the app runs it itself) instead of the real API.
# Must be true with sk_sandbox_ keys and false with sk_live_ keys; the app refuses to boot otherwise.
RESELLER_MOCK=true
RESELLER_MOCK_URL=http://127.0.0.1:4010/api/reseller/v1

# --- groq ---
GROQ_API_KEY=
# Comma separated, best first; a rate limited model is skipped until its reset.
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# Model calls at once across all buyers (a few more wait briefly, the rest get scripted replies).
LLM_CONCURRENCY=6

# --- database ---
# Neon pooled connection string, with sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- business ---
UNIT_PRICE_NGN=5000
MAX_QTY_PER_ORDER=10
# Alert when the reseller balance covers fewer than this many links
LOW_BALANCE_ORDERS=5
# WhatsApp support in international format, no + (buyers see 08087357158)
SUPPORT_WHATSAPP_INTL=2348087357158
# Minutes after delivery before the one "did you activate your link?" reminder
REMINDER_DELAY_MINUTES=180
# The offer line ("offer ending very soon") is not here: admins change it with /offertext.
# Hours between the owner's sales summaries (none from 23:00 to 07:00 WAT).
SUMMARY_EVERY_HOURS=5
# Fallback payment window when the Bachs session response has no expiry.
BACHS_SESSION_TTL_MINUTES=15

# --- channel gate ---
# Buyers must be members to tap [continue]. The bot must be an admin of the channel.
# If the membership check errors, buyers are let through and admins are alerted.
GATE_CHANNEL=@samkieldevtg
GATE_CHANNEL_URL=https://t.me/samkieldevtg

# --- delivery and referrals ---
# Telegram confetti message effect on the delivery message (private chats only).
MESSAGE_EFFECT_CONFETTI=5046509860389126442
# Friends who must buy to earn 1 free link, and the most free links one person can earn.
# Referral links use TELEGRAM_BOT_USERNAME: https://t.me/<username>?start=ref_<code>
REFERRAL_THRESHOLD=3
REFERRAL_MAX_REWARDS=3

# --- alerts ---
# Every alert goes to email, to each ADMIN_TELEGRAM_IDS chat and to ntfy, all at once.
ALERT_EMAIL=ezekiel.samuel@samkiel.tech
# Must be on a domain verified in Resend (samkiel.dev is). Resend's shared onboarding@resend.dev
# sender only delivers to the Resend account's own email.
ALERT_EMAIL_FROM=geminipro alerts <hello@samkiel.dev>
# Optional. Without it, email alerts are only logged.
RESEND_API_KEY=
# ntfy topics are public: pick a long, hard to guess name and subscribe to it in the ntfy app.
NTFY_TOPIC=
# Optional: your own ntfy server instead of https://ntfy.sh.
NTFY_SERVER=

# --- optional ---
# Stop selling after this time. ISO with offset, e.g. 2026-10-29T19:30:00+01:00. Empty = no cutoff.
SALES_CUTOFF=

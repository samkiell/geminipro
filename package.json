{
  "name": "geminipro",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram agent that sells Gemini Pro 18 month activation links",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "mock:reseller": "tsx src/dev/mock-reseller.ts",
    "order:test": "tsx scripts/create-test-order.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "proof:optimize": "tsx scripts/optimize-proof.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@types/node": "^22.20.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "groq-sdk": "^1.6.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
